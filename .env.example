# Copy this file to .env and fill in the key(s) you plan to use.
# .env is gitignored — it will not be committed.

# Groq (default backend, free tier). Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic (optional alternative backend, --backend anthropic). Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
